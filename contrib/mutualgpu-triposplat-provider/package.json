{
  "name": "@ai3d/triposplat-mutualgpu-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test test/*.test.mjs",
