{
  "name": "triposplat-webgpu",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-local WebGPU engineering preview of the TripoSplat image-to-3D pipeline.",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/sync_ort_assets.mjs",
    "prebuild": "pnpm --filter @ai3d/gaussian-scene build && pnpm --filter @ai3d/triposplat-webgpu build",
    "pretypecheck": "pnpm --filter @ai3d/gaussian-scene build && pnpm --filter @ai3d/triposplat-webgpu build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "node scripts/deploy.mjs",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.ts",
    "test:package-consumer": "node scripts/test_packed_vite_consumer.mjs",
    "build:viewer": "pnpm --filter @bring-shrubbery/sharp-splat-viewer build",
    "audit:public": "node scripts/audit_public_repo.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@manycore/aholo-viewer": "^1.5.1",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@ml-sharp-web/ply-metadata": "workspace:*",
    "dialkit": "^1.3.0",
    "exifr": "^7.1.3",
    "motion": "^12.42.2",
    "onnxruntime-web": "1.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reconstruction-image-prep": "github:yosun/ai-image-prep#af80ef43f101ebdf6c7da3933b3be47662dd0169",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "keywords": [
    "triposplat",
    "webgpu",
    "image-to-3d",
    "gaussian-splats",
    "onnx"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai3d-dev/TripoSplatWebGPU.git"
  },
  "bugs": {
    "url": "https://github.com/ai3d-dev/TripoSplatWebGPU/issues"
  },
  "homepage": "https://github.com/ai3d-dev/TripoSplatWebGPU#readme"
}
